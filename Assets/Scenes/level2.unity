    - target: {fileID: 1376366610607223059, guid: 34ce4da5429da47aab2436b9342035fa, type: 3}
      propertyPath: m_text
      value: "\u041A\u0430\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
        \u0447\u0442\u043E \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?\r\n\r\n1.
        \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438 \u043D\u043E\u0443\u0442\u0431\u0443\u043A
        \u043A \u0441\u0432\u043E\u0435\u0439 Wi-Fi \u0441\u0435\u0442\u0438\r\n2.
        \u041E\u0442\u043A\u0440\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u0443\u044E
        \u0441\u0442\u0440\u043E\u043A\u0443\r\n3. \u041D\u0430\u043F\u0438\u0448\u0438
        ping 192.168.1.1 \u2014 \u044D\u0442\u043E \u0440\u043E\u0443\u0442\u0435\u0440\r\n4.
        \u041D\u0430\u043F\u0438\u0448\u0438 ping 192.168.1.100 \u2014 \u044D\u0442\u043E
        \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439 \u041F\u041A\r\n\r\n\u0415\u0441\u043B\u0438
        \u043D\u0430 \u043E\u0431\u0430 \u043F\u0438\u043D\u0433\u0430 \u043F\u0440\u0438\u0448\u0451\u043B
        \u043E\u0442\u0432\u0435\u0442 \u2014 \u0442\u044B \u0432\u0441\u0451 \u0441\u0434\u0435\u043B\u0430\u043B
        \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E!"
      objectReference: {fileID: 0}
