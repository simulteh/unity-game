      objectReference: {fileID: 0}
    - target: {fileID: 3112158297823524561, guid: 34ce4da5429da47aab2436b9342035fa, type: 3}
      propertyPath: m_text
      value: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 Wi-Fi?\r\n\r\n\u042D\u0442\u043E
        \u043A\u043E\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442
        \u043B\u0435\u0442\u0438\u0442 \u043F\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0443,
        \u0430 \u043D\u0435 \u043F\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0430\u043C.
        \u041D\u043E\u0443\u0442\u0431\u0443\u043A \u043C\u043E\u0436\u043D\u043E
        \u0431\u0440\u0430\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439 \u043D\u0430
        \u0434\u0438\u0432\u0430\u043D.\r\n\r\nSSID \u2014 \u044D\u0442\u043E \u0438\u043C\u044F
        \u0442\u0432\u043E\u0435\u0439 \u0441\u0435\u0442\u0438. \u041F\u0440\u0438\u0434\u0443\u043C\u0430\u0439
        \u0435\u0433\u043E \u0441\u0430\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
        \u043E\u0442 \u0441\u043E\u0441\u0435\u0434\u0441\u043A\u0438\u0445.\r\n\r\n\u041F\u0430\u0440\u043E\u043B\u044C
        \u043D\u0443\u0436\u0435\u043D, \u0447\u0442\u043E\u0431\u044B \u0447\u0443\u0436\u0438\u0435
        \u043B\u044E\u0434\u0438 \u043D\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
        \u0442\u0432\u043E\u0438\u043C \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u043E\u043C.
        \u041F\u0440\u0438\u0434\u0443\u043C\u0430\u0439 \u0441\u043B\u043E\u0436\u043D\u044B\u0439
        (8+ \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432), \u043D\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438
        \u0435\u0433\u043E."
      objectReference: {fileID: 0}
